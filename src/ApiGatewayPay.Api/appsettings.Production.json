{
  "AllowedHosts": "api.tu-dominio.com",
  "Platform": {
    "Environment": "Production",
    "ProductionBankHosts": [ "api.banco-ejemplo.com" ]
  },
  "Security": { "RequireHttps": true },
  "Auth": {
    "Mode": "Oidc",
    "Oidc": { "Authority": "https://idp.tu-dominio.com/realms/agp", "Audience": "apigatewaypay", "RequireHttpsMetadata": true }
  },
  "Persistence": { "Provider": "SqlServer", "ConnectionStringSecretName": "db/connection-string", "AutoCreateSchema": false },
  "Secrets": { "Provider": "Vault", "Vault": { "Address": "https://vault.tu-dominio.com", "Mount": "secret", "TokenFile": "/vault/secrets/token" } },
  "OpenApi": { "Enabled": false },
  "Bank": {
    "Adapter": "Real",
    "Name": "banco-ejemplo",
    "Real": { "BaseUrl": "https://api.banco-ejemplo.com" }
  },
  "Backend": {
    "Adapter": "Http",
    "Http": { "BaseUrl": "https://backend.tu-dominio.com" }
  },
  "Network": { "TrustedProxyNetworks": [ "10.0.0.0/8" ] }
}
