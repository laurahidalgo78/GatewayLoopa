{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Platform": {
    "Environment": "Sandbox",
    "SandboxHostMarkers": [ "sandbox", "test", "uat", "qa", "dev", "staging", "localhost", "mock" ],
    "ProductionBankHosts": []
  },
  "Security": {
    "RequireHttps": false,
    "MaxRequestBodyBytes": 65536
  },
  "Auth": {
    "Mode": "Oidc",
    "Oidc": {
      "Authority": "",
      "Audience": "apigatewaypay",
      "RequireHttpsMetadata": true
    },
    "Claims": { "Tenant": "tid", "Scope": "scope" },
    "StepUp": {
      "AcceptedAcr": [ "urn:agp:loa:mfa" ],
      "AcceptedAmr": [ "mfa", "otp", "hwk", "swk" ],
      "RequiredAcr": "urn:agp:loa:mfa",
      "MaxAgeSeconds": 300
    },
    "Local": {
      "AccessTokenMinutes": 5,
      "RefreshTokenMinutes": 30,
      "SessionHours": 8,
      "MaxFailedLogins": 5,
      "LockoutMinutes": 15
    }
  },
  "Persistence": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=apigatewaypay.db",
    "ConnectionStringSecretName": "",
    "AutoCreateSchema": false
  },
  "Secrets": {
    "Provider": "Environment",
    "CacheSeconds": 300,
    "FileDirectory": "/run/secrets",
    "Vault": { "Address": "", "Mount": "secret", "TokenFile": "/vault/secrets/token" }
  },
  "Crypto": { "ActiveKeyVersion": 1 },
  "Features": {
    "Payments": true,
    "AccountsQuery": true,
    "Webhooks": true,
    "Reconciliation": true,
    "BackendNotifications": true
  },
  "Fraud": {
    "Limits": {
      "COP": { "MaxPerTransactionMinor": 5000000000, "DailyMaxMinor": 20000000000, "ApprovalThresholdMinor": 1000000000, "FirstPaymentReviewMinor": 200000000 },
      "USD": { "MaxPerTransactionMinor": 5000000, "DailyMaxMinor": 20000000, "ApprovalThresholdMinor": 1000000, "FirstPaymentReviewMinor": 200000 }
    },
    "VelocityMaxPayments": 10,
    "VelocityWindowSeconds": 60,
    "AnomalyFactor": 5,
    "AnomalyMinHistory": 5,
    "ReviewFirstPaymentToBeneficiary": true
  },
  "Payments": {
    "FirstInquiryDelaySeconds": 30,
    "AmbiguousInquiryDelaySeconds": 5,
    "MaxInquiryDelaySeconds": 3600,
    "InquiryAlertThreshold": 10,
    "MaxSubmissionAttempts": 3,
    "NotFoundGraceSeconds": 300
  },
  "Queue": { "Enabled": true, "PollIntervalMilliseconds": 1000, "BatchSize": 10, "LeaseSeconds": 120, "MaxAttempts": 20 },
  "Workers": { "Enabled": true },
  "Reconciliation": { "IntervalMinutes": 60, "LookbackDays": 1 },
  "Bank": {
    "Adapter": "Mock",
    "Name": "mock",
    "KillSwitch": false,
    "Webhooks": {
      "Algorithm": "HmacSha256",
      "SecretName": "bank/webhook-secret",
      "SignatureHeader": "X-Bank-Signature",
      "TimestampHeader": "X-Bank-Timestamp",
      "NonceHeader": "X-Bank-Nonce",
      "ToleranceSeconds": 300,
      "AllowedCidrs": []
    },
    "Mock": {
      "LatencyMilliseconds": 50,
      "SettlementDelaySeconds": 2,
      "OpeningBalances": { "0012345678901": 100000000000, "0098765432101": 50000000, "0055555555501": 100000000000 },
      "Webhooks": { "Enabled": false }
    },
    "Real": {
      "BaseUrl": "https://api.sandbox.banco-ejemplo.com",
      "Format": "RestJson",
      "Auth": {
        "Type": "OAuth2ClientCredentials",
        "TokenUrl": "https://auth.sandbox.banco-ejemplo.com/oauth2/token",
        "ClientId": "REEMPLAZAR",
        "ClientSecretName": "bank/oauth-client-secret",
        "Scope": "payments accounts"
      },
      "Signing": {
        "Algorithm": "JwsPs256",
        "KeySecretName": "bank/signing-private-key",
        "KeyId": "REEMPLAZAR",
        "HeaderName": "x-jws-signature",
        "VerifyResponses": true,
        "ResponseHeaderName": "x-jws-signature",
        "BankKeySecretName": "bank/bank-public-key"
      },
      "Http": {
        "AllowedHosts": [],
        "RequireHttps": true,
        "TimeoutSeconds": 30,
        "AttemptTimeoutSeconds": 15,
        "MaxRetries": 2,
        "CircuitBreakerFailureRatio": 0.5,
        "CircuitBreakerMinimumThroughput": 10,
        "CircuitBreakerBreakSeconds": 30,
        "PinnedSpkiSha256": [],
        "CheckCertificateRevocation": true,
        "ClientCertificate": {
          "PfxSecretName": "bank/mtls-client-pfx",
          "PfxPasswordSecretName": "bank/mtls-client-pfx-password",
          "ExpiryWarningDays": 30,
          "ExpiryCriticalDays": 7
        }
      },
      "Endpoints": {
        "Balance": "/v1/accounts/{accountId}/balance",
        "Movements": "/v1/accounts/{accountId}/transactions?from={from}&to={to}",
        "Payments": "/v1/payments",
        "PaymentStatus": "/v1/payments/{endToEndId}",
        "Statement": "/v1/statements?date={date}"
      },
      "Iso20022": { "InitiatingPartyName": "", "InitiatingPartyId": "", "DebtorName": "", "DebtorAgentBic": "" },
      "Soap": { "Namespace": "urn:bank:payments:v1", "SoapActionPrefix": "urn:bank:payments:v1#" }
    }
  },
  "Backend": {
    "Adapter": "Mock",
    "Mock": {
      "DeclineReferencesContaining": "DECLINE",
      "Tenants": {
        "tenant-a": [
          { "AccountRef": "ops-cop", "BankAccountId": "0012345678901", "Currency": "COP", "DisplayName": "Operativa COP" },
          { "AccountRef": "ops-usd", "BankAccountId": "0098765432101", "Currency": "USD", "DisplayName": "Operativa USD" }
        ],
        "tenant-b": [
          { "AccountRef": "main-cop", "BankAccountId": "0055555555501", "Currency": "COP", "DisplayName": "Principal COP" }
        ]
      }
    },
    "Http": {
      "BaseUrl": "https://backend.example.internal",
      "Auth": { "Type": "OAuth2ClientCredentials", "TokenUrl": "", "ClientId": "", "ClientSecretName": "backend/oauth-client-secret", "Scope": "" },
      "SigningSecretName": "backend/notify-signing-key",
      "Http": { "AllowedHosts": [], "RequireHttps": true, "TimeoutSeconds": 10, "AttemptTimeoutSeconds": 5, "MaxRetries": 2 },
      "Paths": {
        "TenantAccounts": "/v1/tenants/{tenantId}/accounts",
        "AuthorizePayment": "/v1/payments/authorize",
        "PaymentEvents": "/v1/payments/events",
        "Health": "/health"
      }
    }
  },
  "ExternalServices": {
    "alerts": {
      "Type": "signed-webhook",
      "Enabled": false,
      "BaseUrl": "https://hooks.example.com",
      "Settings": { "Kind": "Alerting", "Path": "/agp/alerts" },
      "Http": { "TimeoutSeconds": 5, "AttemptTimeoutSeconds": 3, "MaxRetries": 0 }
    },
    "sms": {
      "Type": "sms-gateway",
      "Enabled": false,
      "BaseUrl": "https://api.sms-proveedor.example.com",
      "Settings": { "Path": "/v1/messages", "Sender": "AGP" },
      "Auth": { "Type": "ApiKey", "ApiKeyHeader": "Authorization", "ApiKeySecretName": "api-key" },
      "Http": { "TimeoutSeconds": 10, "AttemptTimeoutSeconds": 5, "MaxRetries": 1 }
    }
  },
  "RateLimiting": { "GlobalPerMinute": 300, "AuthPerMinute": 10, "MoneyPerMinute": 30, "WebhooksPerMinute": 600 },
  "Cors": { "AllowedOrigins": [] },
  "Network": { "TrustedProxyNetworks": [] },
  "Telemetry": { "OtlpEndpoint": "" },
  "OpenApi": { "Enabled": false }
}
