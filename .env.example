# =============================================================================
# ApiGatewayPay - variables de entorno (copie a .env; .env está en .gitignore)
# Formato ASP.NET Core: "Seccion__Subseccion__Clave" equivale a Seccion:Subseccion:Clave.
# Las variables de entorno SOBREESCRIBEN appsettings*.json.
# NUNCA ponga secretos reales aquí: van en el gestor de secretos (Vault/AWS/Azure) o en archivos montados.
# =============================================================================

# ---------- Hosting ----------
ASPNETCORE_ENVIRONMENT=Development          # Development | Staging | Production (hosting)
ASPNETCORE_URLS=http://+:8080

# ---------- Plataforma (entorno de negocio, independiente del hosting) ----------
Platform__Environment=Sandbox               # Sandbox | Production  -> prefijo de secretos y de API keys
# Hosts bancarios de PRODUCCIÓN: un despliegue Sandbox se niega a arrancar si apunta a ellos.
Platform__ProductionBankHosts__0=api.banco-ejemplo.com
# Etiquetas de host que delatan sandbox; un despliegue Production se niega a arrancar si las ve.
# Platform__SandboxHostMarkers__0=sandbox

# ---------- Seguridad HTTP ----------
Security__RequireHttps=false                # true en producción (HSTS + redirección)
Security__MaxRequestBodyBytes=65536
Cors__AllowedOrigins__0=                    # vacío = ningún origen de navegador permitido
Network__TrustedProxyNetworks__0=           # CIDR del ingress/LB; solo ellos pueden fijar X-Forwarded-For
AllowedHosts=*                              # en producción: el/los hostnames públicos

# ---------- Autenticación ----------
Auth__Mode=Local                            # Oidc (producción) | Local (solo desarrollo/sandbox)
Auth__Oidc__Authority=https://idp.tu-dominio.com/realms/agp
Auth__Oidc__Audience=apigatewaypay
Auth__Oidc__RequireHttpsMetadata=true
Auth__Claims__Tenant=tid
Auth__Claims__Scope=scope
Auth__StepUp__RequiredAcr=urn:agp:loa:mfa
Auth__StepUp__MaxAgeSeconds=300
Auth__Local__AccessTokenMinutes=5
Auth__Local__RefreshTokenMinutes=30
Auth__Local__SessionHours=8
Auth__Local__SigningKeySecretName=          # vacío en desarrollo = clave efímera

# ---------- Persistencia ----------
Persistence__Provider=Sqlite                # Sqlite (dev) | SqlServer
Persistence__ConnectionString=Data Source=apigatewaypay.db
Persistence__ConnectionStringSecretName=    # producción: p. ej. db/connection-string (preferible identidad administrada)
Persistence__AutoCreateSchema=false         # producción: false (use db/sqlserver/*.sql)

# ---------- Secretos ----------
Secrets__Provider=Environment               # Config (solo dev) | Environment | File | Vault
Secrets__CacheSeconds=300                   # permite rotar sin reiniciar
Secrets__FileDirectory=/run/secrets
Secrets__Vault__Address=https://vault.tu-dominio.com
Secrets__Vault__Mount=secret
Secrets__Vault__TokenFile=/vault/secrets/token   # escrito por Vault Agent; nunca el token en variables
Secrets__Vault__Http__AllowedHosts__0=vault.tu-dominio.com

# Con Secrets__Provider=Environment, cada secreto es una variable SECRET_<ENTORNO>_<NOMBRE> (ver tabla en README):
# SECRET_SANDBOX_BANK_WEBHOOK_SECRET=
# SECRET_SANDBOX_CRYPTO_FIELD_KEY_V1=       # base64 de 32 bytes:  openssl rand -base64 32
# SECRET_SANDBOX_CRYPTO_FINGERPRINT_KEY=    # base64 de 32 bytes
# SECRET_SANDBOX_LEDGER_HMAC_KEY=           # base64 de 32 bytes
# SECRET_SANDBOX_AUTH_API_KEY_PEPPER=

# ---------- Cifrado ----------
Crypto__ActiveKeyVersion=1                  # rotación: cree field-key-v2, cambie a 2; v1 se sigue leyendo

# ---------- Feature flags por integración ----------
Features__Payments=true
Features__AccountsQuery=true
Features__Webhooks=true
Features__Reconciliation=true
Features__BackendNotifications=true

# ---------- Antifraude y pagos ----------
Fraud__Limits__COP__MaxPerTransactionMinor=5000000000
Fraud__Limits__COP__DailyMaxMinor=20000000000
Fraud__Limits__COP__ApprovalThresholdMinor=1000000000
Fraud__Limits__COP__FirstPaymentReviewMinor=200000000
Fraud__VelocityMaxPayments=10
Fraud__VelocityWindowSeconds=60
Fraud__AnomalyFactor=5
Payments__FirstInquiryDelaySeconds=30
Payments__AmbiguousInquiryDelaySeconds=5
Payments__MaxSubmissionAttempts=3
Payments__NotFoundGraceSeconds=300

# ---------- Cola / workers ----------
Queue__Enabled=true
Queue__PollIntervalMilliseconds=1000
Queue__LeaseSeconds=120
Queue__MaxAttempts=20
Workers__Enabled=true
Reconciliation__IntervalMinutes=60
Reconciliation__LookbackDays=1

# ---------- Banco ----------
Bank__Adapter=Mock                          # Mock | Real
Bank__Name=mock                             # identifica al proveedor y la ruta /v1/webhooks/bank/{Name}
Bank__KillSwitch=false                      # palanca de emergencia por despliegue (además del endpoint admin)
Bank__Webhooks__Algorithm=HmacSha256        # HmacSha256 | RsaSha256 | EcdsaSha256
Bank__Webhooks__SecretName=bank/webhook-secret
Bank__Webhooks__ToleranceSeconds=300
Bank__Webhooks__AllowedCidrs__0=            # rangos IP publicados por el banco
Bank__Mock__SettlementDelaySeconds=2
Bank__Mock__Webhooks__Enabled=false

Bank__Real__BaseUrl=https://api.sandbox.banco-ejemplo.com
Bank__Real__Format=RestJson                 # RestJson | Iso20022 | Soap
Bank__Real__Auth__Type=OAuth2ClientCredentials   # None | ApiKey | OAuth2ClientCredentials
Bank__Real__Auth__TokenUrl=https://auth.sandbox.banco-ejemplo.com/oauth2/token
Bank__Real__Auth__ClientId=
Bank__Real__Auth__ClientSecretName=bank/oauth-client-secret
Bank__Real__Auth__Scope=payments accounts
Bank__Real__Signing__Algorithm=JwsPs256     # None | HmacSha256 | JwsRs256 | JwsPs256 | JwsEs256
Bank__Real__Signing__KeySecretName=bank/signing-private-key
Bank__Real__Signing__KeyId=
Bank__Real__Signing__VerifyResponses=true
Bank__Real__Signing__BankKeySecretName=bank/bank-public-key
Bank__Real__Http__TimeoutSeconds=30
Bank__Real__Http__AttemptTimeoutSeconds=15
Bank__Real__Http__MaxRetries=2              # solo aplica a consultas; los pagos nunca se reintentan aquí
Bank__Real__Http__CircuitBreakerBreakSeconds=30
Bank__Real__Http__CheckCertificateRevocation=true
Bank__Real__Http__PinnedSpkiSha256__0=      # pin principal (base64 SHA-256 del SPKI)
Bank__Real__Http__PinnedSpkiSha256__1=      # pin de respaldo (obligatorio si usa pinning)
Bank__Real__Http__CustomRootCaSecretName=   # CA privada del banco (PEM), si aplica
Bank__Real__Http__ClientCertificate__PfxSecretName=bank/mtls-client-pfx
Bank__Real__Http__ClientCertificate__PfxPasswordSecretName=bank/mtls-client-pfx-password
Bank__Real__Http__ClientCertificate__ExpiryWarningDays=30
Bank__Real__Http__ClientCertificate__ExpiryCriticalDays=7
Bank__Real__Iso20022__InitiatingPartyName=
Bank__Real__Iso20022__InitiatingPartyId=
Bank__Real__Iso20022__DebtorName=
Bank__Real__Iso20022__DebtorAgentBic=

# ---------- Backend ----------
Backend__Adapter=Mock                       # Mock | Http
Backend__Http__BaseUrl=https://backend.tu-dominio.com
Backend__Http__Auth__Type=OAuth2ClientCredentials
Backend__Http__Auth__TokenUrl=
Backend__Http__Auth__ClientId=
Backend__Http__Auth__ClientSecretName=backend/oauth-client-secret
Backend__Http__SigningSecretName=backend/notify-signing-key
Backend__Http__Http__TimeoutSeconds=10

# ---------- Servicios externos (un bloque por instancia) ----------
ExternalServices__alerts__Enabled=false
ExternalServices__alerts__Type=signed-webhook
ExternalServices__alerts__BaseUrl=https://hooks.example.com
ExternalServices__sms__Enabled=false
ExternalServices__sms__Type=sms-gateway
ExternalServices__sms__BaseUrl=https://api.sms-proveedor.example.com

# ---------- Límites de tasa ----------
RateLimiting__GlobalPerMinute=300
RateLimiting__AuthPerMinute=10
RateLimiting__MoneyPerMinute=30
RateLimiting__WebhooksPerMinute=600

# ---------- Observabilidad ----------
Telemetry__OtlpEndpoint=                    # p. ej. http://otel-collector:4317
OpenApi__Enabled=false                      # true solo en desarrollo

# ---------- Solo docker-compose (desarrollo) ----------
MSSQL_SA_PASSWORD=CambieEsto-Dev-2026!
VAULT_DEV_ROOT_TOKEN=dev-only-root-token
