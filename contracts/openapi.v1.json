{
  "openapi": "3.1.1",
  "info": {
    "title": "ApiGatewayPay",
    "description": "API segura de pagos y conexión bancaria. Errores en formato RFC 9457 (application/problem+json).",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080/"
    }
  ],
  "paths": {
    "/v1/webhooks/bank/{provider}": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/payments": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Crea un pago (requiere Idempotency-Key)",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Payments"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/PaymentStatus"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/payments/{id}": {
      "get": {
        "tags": [
          "Payments"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/payments/{id}/approve": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Aprueba un pago pendiente (maker-checker + MFA reciente)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/payments/{id}/reject": {
      "post": {
        "tags": [
          "Payments"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectPaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/beneficiaries": {
      "post": {
        "tags": [
          "Beneficiaries"
        ],
        "summary": "Registra una cuenta destino en la lista blanca (MFA reciente)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterBeneficiaryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Beneficiaries"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/beneficiaries/{id}/approve": {
      "post": {
        "tags": [
          "Beneficiaries"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/accounts": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/accounts/{accountRef}/balance": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "parameters": [
          {
            "name": "accountRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/accounts/{accountRef}/movements": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "parameters": [
          {
            "name": "accountRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/admin/kill-switch": {
      "get": {
        "tags": [
          "Admin"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KillSwitchState"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Activa/desactiva de inmediato la conexión bancaria (incidentes)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KillSwitchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KillSwitchState"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/api-keys": {
      "post": {
        "tags": [
          "Admin"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedApiKey"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Admin"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApiKeySummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/api-keys/{id}": {
      "delete": {
        "tags": [
          "Admin"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/admin/reconciliation/runs": {
      "post": {
        "tags": [
          "Admin"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReconciliationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationReport"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/reconciliation/runs/{id}": {
      "get": {
        "tags": [
          "Admin"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/admin/ledger/verify": {
      "get": {
        "tags": [
          "Admin"
        ],
        "parameters": [
          {
            "name": "aggregateType",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "aggregateId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerVerification"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/token": {
      "post": {
        "tags": [
          "Auth (solo desarrollo)"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/auth/revoke": {
      "post": {
        "tags": [
          "Auth (solo desarrollo)"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountType": {
        "enum": [
          "savings",
          "checking",
          "electronic",
          null
        ]
      },
      "ApiKeySummary": {
        "required": [
          "keyId",
          "name",
          "scopes",
          "createdAt",
          "expiresAt",
          "revokedAt",
          "lastUsedAt"
        ],
        "type": "object",
        "properties": {
          "keyId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CreateApiKeyRequest": {
        "required": [
          "name",
          "scopes"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[\\p{L}\\p{N} .,:;'\\-_/#()]+$",
            "type": "string"
          },
          "scopes": {
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expiresInDays": {
            "maximum": 365,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreatedApiKey": {
        "required": [
          "keyId",
          "key",
          "scopes",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "keyId": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CreatePaymentRequest": {
        "required": [
          "beneficiaryId",
          "currency",
          "reference"
        ],
        "type": "object",
        "properties": {
          "beneficiaryId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "amountMinor": {
            "maximum": 99999999999999,
            "minimum": 1,
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "reference": {
            "maxLength": 140,
            "minLength": 1,
            "pattern": "^[\\p{L}\\p{N} .,:;'\\-_/#()]+$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DiscrepancySeverity": {
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ]
      },
      "KillSwitchRequest": {
        "required": [
          "active",
          "reason"
        ],
        "type": "object",
        "properties": {
          "active": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "reason": {
            "maxLength": 200,
            "minLength": 5,
            "pattern": "^[\\p{L}\\p{N} .,:;'\\-_/#()]+$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "KillSwitchState": {
        "required": [
          "active",
          "reason",
          "changedBy",
          "changedAt",
          "fromConfiguration"
        ],
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "changedBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "changedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "fromConfiguration": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "LedgerVerification": {
        "required": [
          "valid",
          "aggregatesChecked",
          "entriesChecked",
          "firstProblem"
        ],
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "aggregatesChecked": {
            "type": "integer",
            "format": "int32"
          },
          "entriesChecked": {
            "type": "integer",
            "format": "int32"
          },
          "firstProblem": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "PaymentStatus": {
        "enum": [
          "created",
          "pending_approval",
          "approved",
          "rejected",
          "sent",
          "unknown",
          "confirmed",
          "failed",
          "reversed",
          null
        ]
      },
      "ReconciliationDiscrepancy": {
        "required": [
          "type",
          "severity",
          "endToEndId",
          "paymentId",
          "detail"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/DiscrepancySeverity"
          },
          "endToEndId": {
            "type": [
              "null",
              "string"
            ]
          },
          "paymentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ReconciliationReport": {
        "required": [
          "id",
          "date",
          "startedAt",
          "finishedAt",
          "internalCount",
          "bankCount",
          "discrepancies"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "internalCount": {
            "type": "integer",
            "format": "int32"
          },
          "bankCount": {
            "type": "integer",
            "format": "int32"
          },
          "discrepancies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReconciliationDiscrepancy"
            }
          }
        },
        "additionalProperties": false
      },
      "ReconciliationRequest": {
        "required": [
          "date"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        },
        "additionalProperties": false
      },
      "RegisterBeneficiaryRequest": {
        "required": [
          "displayName",
          "bankCode",
          "accountType",
          "accountNumber"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "maxLength": 140,
            "minLength": 2,
            "pattern": "^[\\p{L}\\p{N} .,:;'\\-_/#()]+$",
            "type": "string"
          },
          "bankCode": {
            "pattern": "^[0-9A-Z]{3,11}$",
            "type": "string"
          },
          "accountType": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AccountType"
              }
            ]
          },
          "accountNumber": {
            "pattern": "^[0-9]{6,20}$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RejectPaymentRequest": {
        "required": [
          "reasonCode"
        ],
        "type": "object",
        "properties": {
          "reasonCode": {
            "pattern": "^[a-z_]{3,32}$",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Access token OAuth2/OIDC (vida corta).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "ApiKey": {
        "type": "apiKey",
        "description": "API key de cliente máquina.",
        "name": "X-Api-Key",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    },
    {
      "ApiKey": [ ]
    }
  ],
  "tags": [
    {
      "name": "Webhooks"
    },
    {
      "name": "Payments"
    },
    {
      "name": "Beneficiaries"
    },
    {
      "name": "Accounts"
    },
    {
      "name": "Admin"
    },
    {
      "name": "Auth (solo desarrollo)"
    }
  ]
}